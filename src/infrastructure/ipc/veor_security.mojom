module veor.mojom;

// ─────────────────────────────────────────────────────────────────────────────
// SecurityPolicy — Browser -> Renderer
// ─────────────────────────────────────────────────────────────────────────────

interface SecurityPolicy {
  // Grants a permission for this renderer's origin.
  GrantPermission(int32 permission_type);

  // Revokes a permission.
  RevokePermission(int32 permission_type);

  // Injects Content Security Policy directives.
  SetCspPolicy(string policy_string);

  // Blocks/allows mixed content.
  // mode: 0=block, 1=warn, 2=allow
  SetMixedContentMode(int32 mode);
};
