import("//build/config/compiler/compiler.gni")
import("//mojo/public/tools/bindings/mojom.gni")

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure Layer — Storage, Network, Crypto, Platform, IPC
# ─────────────────────────────────────────────────────────────────────────────

source_set("storage") {
  sources = [
    "storage/IStorageEngine.h",
    "storage/StorageEngineImpl.h",
    "storage/StorageEngineImpl.cc",
  ]

  deps = [
    "//veor/src/core:core",
    "//sql",
  ]

  public_configs = [ "//veor/src/core:veor_core_public" ]
}

source_set("network") {
  sources = [
    "network/INetworkService.h",
    "network/NetworkServiceImpl.h",
    "network/NetworkServiceImpl.cc",
  ]

  deps = [
    "//veor/src/core:core",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//net",
  ]

  public_configs = [ "//veor/src/core:veor_core_public" ]
}

source_set("crypto") {
  sources = [
    "crypto/ICryptoVault.h",
    "crypto/CryptoVaultImpl.h",
    "crypto/CryptoVaultImpl.cc",
  ]

  deps = [
    "//veor/src/core:core",
    "//third_party/boringssl",
  ]

  public_configs = [ "//veor/src/core:veor_core_public" ]
}

source_set("platform") {
  sources = [
    "platform/IPlatformService.h",
    "platform/PlatformServiceImpl.h",
    "platform/PlatformServiceImpl.cc",
  ]

  deps = [
    "//veor/src/core:core",
    "//base",
  ]

  public_configs = [ "//veor/src/core:veor_core_public" ]
}

mojom("ipc_mojom") {
  sources = [
    "ipc/veor_tab.mojom",
    "ipc/veor_extension.mojom",
    "ipc/veor_security.mojom",
  ]
}

source_set("infrastructure") {
  deps = [
    ":storage",
    ":network",
    ":crypto",
    ":platform",
    ":ipc_mojom",
  ]
}

# ─────────────────────────────────────────────────────────────────────────────
# Unit Tests
# ─────────────────────────────────────────────────────────────────────────────

executable("infrastructure_unittests") {
  testonly = true
  sources = [
    "storage/StorageEngineImpl_unittest.cc",
    "crypto/CryptoVaultImpl_unittest.cc",
    "platform/PlatformServiceImpl_unittest.cc",
  ]

  deps = [
    ":infrastructure",
    "//veor/src/core:test_support",
    "//base",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
